# Chiave API di Anthropic per generare i documenti con Claude
ANTHROPIC_API_KEY=
# Chiave API di AssemblyAI per la trascrizione con riconoscimento di chi parla
ASSEMBLYAI_API_KEY=
# Password per accedere all'app (la chiede il browser al primo accesso)
APP_PASSWORD=
# Cartella dove salvare audio, trascrizioni e documenti
DATA_DIR=./data
PORT=3000
# 1 = non chiama i servizi esterni, utile per provare l'app in locale
MOCK_AI=0
